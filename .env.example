# Copia este archivo a .env y ajusta los valores.

# Base de datos. Postgres en docker-compose o SQLite para desarrollo rápido.
DATABASE_URL=
# DATABASE_URL=sqlite+aiosqlite:///./origen.db

# Genera uno con: openssl rand -hex 32
JWT_SECRET=

# Clave AES-256-GCM para los datos personales de las reservas (32 bytes).
# Genera una con: openssl rand -base64 32
# En desarrollo, si se omite, se crea backend/.origen-data-key (ignorado por git).
DATA_ENCRYPTION_KEY=

# Hosts aceptados por la API (separados por coma). Sin "*" en producción.
ALLOWED_HOSTS=localhost,127.0.0.1

# Actívalo solo detrás de un proxy de confianza que reescriba X-Forwarded-For.
TRUST_PROXY=false

# Tamaño máximo del cuerpo de una petición, en bytes.
MAX_BODY_BYTES=65536

# Zona del restaurante para validar las fechas de reserva. Si el sistema no
# trae la base de zonas (Windows sin tzdata), se usa el desfase fijo de abajo.
RESTAURANT_TZ=America/Havana
RESTAURANT_UTC_OFFSET=-5

# Pool de Postgres por proceso. El total (pool + overflow) × réplicas debe
# quedar por debajo de max_connections del servidor.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Bloqueo del login: 5 fallos por ventana de 24 h; 24 h, 72 h, 216 h…
LOGIN_ATTEMPT_LIMIT=5
LOGIN_WINDOW_SECONDS=86400
LOGIN_LOCK_BASE_SECONDS=86400
LOGIN_LOCK_FACTOR=3
LOGIN_LOCK_MAX_SECONDS=2592000
LOGIN_MAX_STRIKES=5

# Origen permitido para CORS (el frontend nunca llama al backend desde el navegador,
# pero se deja cerrado por si se consume la API directamente).
FRONTEND_ORIGIN=http://localhost:3000

# Cookies Secure: true en producción (HTTPS obligatorio).
COOKIE_SECURE=false

# Crea el usuario demo@theorigen.cu al arrancar. Solo para el demo.
SEED_DEMO=true

# development | production
APP_ENV=development

# URL pública del sitio (metadatos y Open Graph). También en frontend/.env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contraseña del Postgres de docker-compose (por defecto: origen).
POSTGRES_PASSWORD=origen

# --- Producción (backend en Vercel, frontend en Render) -------------------
# APP_ENV=production
# SEED_DEMO=false
# FRONTEND_ORIGIN=https://the-origen-frontend.onrender.com
# COOKIE_SECURE=true
# ALLOWED_HOSTS=the-origen-backend.vercel.app,*.vercel.app
# Actívalo solo si la plataforma sobrescribe X-Forwarded-For con la IP real.
# TRUST_PROXY=true

# URL pública del backend. El navegador nunca llama a este dominio: pide
# /backend/api/v1/* y Next reescribe a esta URL desde el servidor.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Solo si el proceso de Next no puede alcanzar NEXT_PUBLIC_API_URL.
# docker-compose usa el nombre del servicio: http://api:8000
# Déjalo vacío para reutilizar NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# URL pública del frontend, sin barra final. Se usa en canonical, hreflang,
# sitemap, robots, Open Graph y el manifest.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Producción (Render):
# NEXT_PUBLIC_API_URL=https://the-origen-backend.vercel.app
# API_INTERNAL_URL=https://the-origen-backend.vercel.app
# NEXT_PUBLIC_SITE_URL=https://the-origen-frontend.onrender.com
